lvl_0600.refresh_lvl(txt_0600, ls_key, ls_key_test_str), lvl_0730.refresh_lvl(txt_0730, ls_key, ls_key_test_str), lvl_0830.refresh_lvl(txt_0830, ls_key, ls_key_test_str)
