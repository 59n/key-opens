// =========================================================================
// INFO PANEL
// =========================================================================
type TableRow
    string name
    float  p
    bool   tested
    int    tap_t
    bool   is_header = false

if barstate.islast and show_panel
    eff_chk_bg  = chk_copy_colors ? panel_bg      : chk_bg
    eff_chk_brd = chk_copy_colors ? panel_border   : chk_border
    eff_chk_txt = chk_copy_colors ? panel_txt_col  : chk_txt_col
    do_below    = show_chk_panel and combine_mode == "Below"
    do_right    = show_chk_panel and combine_mode == "Right"

    var chk_labels_info = array.new_string()
    array.clear(chk_labels_info)
    if do_below or do_right
        if chk1_show and str.length(chk1_txt) > 0
            array.push(chk_labels_info, chk1_txt)
        if chk2_show and str.length(chk2_txt) > 0
            array.push(chk_labels_info, chk2_txt)
        if chk3_show and str.length(chk3_txt) > 0
            array.push(chk_labels_info, chk3_txt)
        if chk4_show and str.length(chk4_txt) > 0
            array.push(chk_labels_info, chk4_txt)
        if chk5_show and str.length(chk5_txt) > 0
            array.push(chk_labels_info, chk5_txt)

    var rows = array.new<TableRow>()
    array.clear(rows)

    // --- KEY LEVELS section ---
    sec = array.size(rows)
    if lvl_1800.drawn
        array.push(rows, TableRow.new(txt_1800, lvl_1800.p, lvl_1800.tested, lvl_1800.tap_time))
    if lvl_1930.drawn
        array.push(rows, TableRow.new(txt_1930, lvl_1930.p, lvl_1930.tested, lvl_1930.tap_time))
    if lvl_2200.drawn
        array.push(rows, TableRow.new(txt_2200, lvl_2200.p, lvl_2200.tested, lvl_2200.tap_time))
    if lvl_0000.drawn
        array.push(rows, TableRow.new(txt_0000, lvl_0000.p, lvl_0000.tested, lvl_0000.tap_time))
    if lvl_0130.drawn
        array.push(rows, TableRow.new(txt_0130, lvl_0130.p, lvl_0130.tested, lvl_0130.tap_time))
    if lvl_0200.drawn
        array.push(rows, TableRow.new(txt_0200, lvl_0200.p, lvl_0200.tested, lvl_0200.tap_time))
    if lvl_0300.drawn
        array.push(rows, TableRow.new(txt_0300, lvl_0300.p, lvl_0300.tested, lvl_0300.tap_time))
    if lvl_0600.drawn
        array.push(rows, TableRow.new(txt_0600, lvl_0600.p, lvl_0600.tested, lvl_0600.tap_time))
    if lvl_0730.drawn
        array.push(rows, TableRow.new(txt_0730, lvl_0730.p, lvl_0730.tested, lvl_0730.tap_time))
    if lvl_0830.drawn
        array.push(rows, TableRow.new(txt_0830, lvl_0830.p, lvl_0830.tested, lvl_0830.tap_time))
    if lvl_0930.drawn
        array.push(rows, TableRow.new(txt_0930, lvl_0930.p, lvl_0930.tested, lvl_0930.tap_time))
    if lvl_1000.drawn
        array.push(rows, TableRow.new(txt_1000, lvl_1000.p, lvl_1000.tested, lvl_1000.tap_time))
    if lvl_nq_1000.drawn
        array.push(rows, TableRow.new(txt_nq_1000, lvl_nq_1000.p, lvl_nq_1000.tested, lvl_nq_1000.tap_time))
    if lvl_mnq_1000.drawn
        array.push(rows, TableRow.new(txt_mnq_1000, lvl_mnq_1000.p, lvl_mnq_1000.tested, lvl_mnq_1000.tap_time))
    if lvl_c1.drawn
        array.push(rows, TableRow.new(txt_c1, lvl_c1.p, lvl_c1.tested, lvl_c1.tap_time))
    if lvl_c2.drawn
        array.push(rows, TableRow.new(txt_c2, lvl_c2.p, lvl_c2.tested, lvl_c2.tap_time))
    if lvl_c3.drawn
        array.push(rows, TableRow.new(txt_c3, lvl_c3.p, lvl_c3.tested, lvl_c3.tap_time))
    if array.size(rows) > sec
        array.insert(rows, sec, TableRow.new(name="KEY LEVELS", is_header=true))

    // --- WEEKLY / MONTHLY section ---
    sec := array.size(rows)
    if lvl_wo.drawn
        array.push(rows, TableRow.new(txt_wo,  lvl_wo.p,  lvl_wo.tested,  lvl_wo.tap_time))
    if lvl_two.drawn
        array.push(rows, TableRow.new(txt_two, lvl_two.p, lvl_two.tested, lvl_two.tap_time))
    if lvl_mo.drawn
        array.push(rows, TableRow.new(txt_mo,  lvl_mo.p,  lvl_mo.tested,  lvl_mo.tap_time))
    if lvl_tmo.drawn
        array.push(rows, TableRow.new(txt_tmo, lvl_tmo.p, lvl_tmo.tested, lvl_tmo.tap_time))
    if array.size(rows) > sec
        array.insert(rows, sec, TableRow.new(name="WEEKLY / MONTHLY", is_header=true))

    // --- PREV DAY / ATH section ---
    sec := array.size(rows)
    if lvl_pdh.drawn
        array.push(rows, TableRow.new(txt_pdh, lvl_pdh.p, lvl_pdh.tested, lvl_pdh.tap_time))
    if lvl_pdl.drawn
        array.push(rows, TableRow.new(txt_pdl, lvl_pdl.p, lvl_pdl.tested, lvl_pdl.tap_time))
    if lvl_ath.drawn
        array.push(rows, TableRow.new(txt_ath, lvl_ath.p, lvl_ath.tested, lvl_ath.tap_time))
    if lvl_pwh.drawn
        array.push(rows, TableRow.new(txt_pwh, lvl_pwh.p, lvl_pwh.tested, lvl_pwh.tap_time))
    if lvl_pwl.drawn
        array.push(rows, TableRow.new(txt_pwl, lvl_pwl.p, lvl_pwl.tested, lvl_pwl.tap_time))
    if array.size(rows) > sec
        array.insert(rows, sec, TableRow.new(name="PREV DAY / ATH", is_header=true))

    // --- SESSIONS section ---
    sec := array.size(rows)
    if panel_asia_hl
        if lvl_asia_h.drawn
            array.push(rows, TableRow.new(txt_asia_h, lvl_asia_h.p, lvl_asia_h.tested, lvl_asia_h.tap_time))
        if lvl_asia_l.drawn
            array.push(rows, TableRow.new(txt_asia_l, lvl_asia_l.p, lvl_asia_l.tested, lvl_asia_l.tap_time))
    if panel_lon_hl
        if lvl_lon_h.drawn
            array.push(rows, TableRow.new(txt_lon_h, lvl_lon_h.p, lvl_lon_h.tested, lvl_lon_h.tap_time))
        if lvl_lon_l.drawn
            array.push(rows, TableRow.new(txt_lon_l, lvl_lon_l.p, lvl_lon_l.tested, lvl_lon_l.tap_time))
    if panel_ny_hl
        if lvl_ny_h.drawn
            array.push(rows, TableRow.new(txt_ny_h, lvl_ny_h.p, lvl_ny_h.tested, lvl_ny_h.tap_time))
        if lvl_ny_l.drawn
            array.push(rows, TableRow.new(txt_ny_l, lvl_ny_l.p, lvl_ny_l.tested, lvl_ny_l.tap_time))
    if panel_nypm_hl
        if lvl_nypm_h.drawn
            array.push(rows, TableRow.new(txt_nypm_h, lvl_nypm_h.p, lvl_nypm_h.tested, lvl_nypm_h.tap_time))
        if lvl_nypm_l.drawn
            array.push(rows, TableRow.new(txt_nypm_l, lvl_nypm_l.p, lvl_nypm_l.tested, lvl_nypm_l.tap_time))
    if array.size(rows) > sec
        array.insert(rows, sec, TableRow.new(name="SESSIONS", is_header=true))

    // --- GAPS section ---
    sec := array.size(rows)
    if gap_ndog.drawn
        if gap_ndog.show_top
            array.push(rows, TableRow.new(txt_ndog + " Top", gap_ndog.p_top, gap_ndog.tested_top, gap_ndog.tap_time_top))
        if gap_ndog.show_mid
            array.push(rows, TableRow.new(txt_ndog + " Mid", gap_ndog.p_mid, gap_ndog.tested_mid, gap_ndog.tap_time_mid))
        if gap_ndog.show_btm
            array.push(rows, TableRow.new(txt_ndog + " Btm", gap_ndog.p_btm, gap_ndog.tested_btm, gap_ndog.tap_time_btm))
    if gap_nwog.drawn
        if gap_nwog.show_top
            array.push(rows, TableRow.new(txt_nwog + " Top", gap_nwog.p_top, gap_nwog.tested_top, gap_nwog.tap_time_top))
        if gap_nwog.show_mid
            array.push(rows, TableRow.new(txt_nwog + " Mid", gap_nwog.p_mid, gap_nwog.tested_mid, gap_nwog.tap_time_mid))
        if gap_nwog.show_btm
            array.push(rows, TableRow.new(txt_nwog + " Btm", gap_nwog.p_btm, gap_nwog.tested_btm, gap_nwog.tap_time_btm))
    if array.size(rows) > sec
        array.insert(rows, sec, TableRow.new(name="GAPS", is_header=true))

    int total_rows     = array.size(rows)
    int chk_info_count = array.size(chk_labels_info)
    chk_sz             = get_sz(chk_size_str)

    int info_cols = 2
    if show_panel_price
        info_cols += 1
    if show_panel_time
        info_cols += 1
    int total_cols = do_right and chk_info_count > 0 ? info_cols + 1 : info_cols

    // Below: extra rows = header + items. Right: extra rows = 0 (uses existing rows).
    int below_extra = do_below and chk_info_count > 0 ? chk_info_count + 1 : 0
    int table_rows  = do_right and chk_info_count > 0 ? math.max(total_rows, chk_info_count) + 1 : total_rows + 1 + below_extra

    var table info_panel = na
    if not na(info_panel)
        table.delete(info_panel)

    if table_rows > 1 or (do_right and chk_info_count > 0)
        info_panel := table.new(get_pos(panel_pos_str), total_cols, table_rows, bgcolor=panel_bg, border_width=1, border_color=panel_border, frame_color=panel_border, frame_width=1)
        sz = get_sz(panel_size_str)

        // Header row
        int col_idx = 0
        table.cell(info_panel, col_idx, 0, "LEVEL",  text_color=panel_txt_col, text_size=sz, text_halign=text.align_left, bgcolor=color.new(color.black, 50))
        col_idx += 1
        if show_panel_price
            table.cell(info_panel, col_idx, 0, "PRICE",  text_color=panel_txt_col, text_size=sz, text_halign=text.align_left, bgcolor=color.new(color.black, 50))
            col_idx += 1
        table.cell(info_panel, col_idx, 0, "STATUS", text_color=panel_txt_col, text_size=sz, text_halign=text.align_left, bgcolor=color.new(color.black, 50))
        col_idx += 1
        if show_panel_time
            table.cell(info_panel, col_idx, 0, "TAPPED (" + tz + ")", text_color=panel_txt_col, text_size=sz, text_halign=text.align_left, bgcolor=color.new(color.black, 50))
            col_idx += 1
        if do_right and chk_info_count > 0
            table.cell(info_panel, col_idx, 0, "CHECKLIST", text_color=eff_chk_txt, text_size=chk_sz, text_halign=text.align_left, bgcolor=color.new(color.black, 50))

        // Info rows
        int max_data_rows = do_right ? math.max(total_rows, chk_info_count) : total_rows
        for i = 0 to max_data_rows - 1
            int curr_col = 0
            if i < total_rows
                r = array.get(rows, i)
                if r.is_header
                    // Section header row — darker background, name spans visually across all cols
                    table.cell(info_panel, 0, i+1, r.name, text_color=panel_txt_col, text_size=sz, text_halign=text.align_left, bgcolor=color.new(color.black, 65))
                    for hc = 1 to info_cols - 1
                        table.cell(info_panel, hc, i+1, "", text_color=panel_txt_col, text_size=sz, bgcolor=color.new(color.black, 65))
                    if do_right and chk_info_count > 0
                        chk_val = i < chk_info_count ? array.get(chk_labels_info, i) : ""
                        table.cell(info_panel, info_cols, i+1, chk_val, text_color=eff_chk_txt, text_size=chk_sz, text_halign=text.align_left)
                else
                    stat_col = r.tested ? color.gray : color.new(color.green, 20)
                    stat_txt = r.tested ? "Tapped" + test_text : "Active"
                    table.cell(info_panel, curr_col, i+1, r.name, text_color=panel_txt_col, text_size=sz, text_halign=text.align_left)
                    curr_col += 1
                    if show_panel_price
                        table.cell(info_panel, curr_col, i+1, str.tostring(r.p, format.mintick), text_color=panel_txt_col, text_size=sz, text_halign=text.align_left)
                        curr_col += 1
                    table.cell(info_panel, curr_col, i+1, stat_txt, text_color=stat_col, text_size=sz, text_halign=text.align_left)
                    curr_col += 1
                    if show_panel_time
                        time_str = not na(r.tap_t) ? str.format_time(r.tap_t, "MM/dd HH:mm", tz) : "-"
                        table.cell(info_panel, curr_col, i+1, time_str, text_color=panel_txt_col, text_size=sz, text_halign=text.align_left)
                    // Right-mode: checklist column for data rows
                    if do_right and chk_info_count > 0
                        chk_val = i < chk_info_count ? array.get(chk_labels_info, i) : ""
                        table.cell(info_panel, info_cols, i+1, chk_val, text_color=eff_chk_txt, text_size=chk_sz, text_halign=text.align_left)
            else if do_right
                // Empty info cells when checklist has more rows than info
                table.cell(info_panel, 0, i+1, "", text_color=panel_txt_col, text_size=sz)
                int ec = 1
                if show_panel_price
                    table.cell(info_panel, ec, i+1, "", text_color=panel_txt_col, text_size=sz)
                    ec += 1
                table.cell(info_panel, ec, i+1, "", text_color=panel_txt_col, text_size=sz)
                ec += 1
                if show_panel_time
                    table.cell(info_panel, ec, i+1, "", text_color=panel_txt_col, text_size=sz)
                chk_val = i < chk_info_count ? array.get(chk_labels_info, i) : ""
                table.cell(info_panel, info_cols, i+1, chk_val, text_color=eff_chk_txt, text_size=chk_sz, text_halign=text.align_left)

        // Below-mode: checklist section appended after info rows
        if do_below and chk_info_count > 0
            int divider_row = total_rows + 1
            table.cell(info_panel, 0, divider_row, "CHECKLIST", text_color=eff_chk_txt, text_size=chk_sz, text_halign=text.align_left, bgcolor=color.new(color.black, 50))
            for c = 1 to info_cols - 1
                table.cell(info_panel, c, divider_row, "", text_color=eff_chk_txt, text_size=chk_sz, bgcolor=color.new(color.black, 50))
            for i = 0 to chk_info_count - 1
                table.cell(info_panel, 0, divider_row + 1 + i, array.get(chk_labels_info, i), text_color=eff_chk_txt, text_size=chk_sz, text_halign=text.align_left)
                for c = 1 to info_cols - 1
                    table.cell(info_panel, c, divider_row + 1 + i, "", text_color=eff_chk_txt, text_size=chk_sz)

// =========================================================================
// CHECKLIST PANEL — toggle shows/hides the row, text field is the label
// =========================================================================
if barstate.islast
    sa_chk_bg  = chk_copy_colors ? panel_bg     : chk_bg
    sa_chk_brd = chk_copy_colors ? panel_border  : chk_border
    sa_chk_txt = chk_copy_colors ? panel_txt_col : chk_txt_col

    var chk_labels = array.new_string()
    array.clear(chk_labels)

    if show_chk_panel
        if chk1_show and str.length(chk1_txt) > 0
            array.push(chk_labels, chk1_txt)
        if chk2_show and str.length(chk2_txt) > 0
            array.push(chk_labels, chk2_txt)
        if chk3_show and str.length(chk3_txt) > 0
            array.push(chk_labels, chk3_txt)
        if chk4_show and str.length(chk4_txt) > 0
            array.push(chk_labels, chk4_txt)
        if chk5_show and str.length(chk5_txt) > 0
            array.push(chk_labels, chk5_txt)

    int chk_count = array.size(chk_labels)
    bool is_combined = combine_mode != "Off" and show_panel

    // Standalone checklist table (only when not merged into info panel)
    if show_chk_panel and not is_combined
        var table chk_panel = na
        if not na(chk_panel)
            table.delete(chk_panel)
        if chk_count > 0
            chk_panel := table.new(get_pos(chk_pos_str), 1, chk_count + 1, bgcolor=sa_chk_bg, border_width=1, border_color=sa_chk_brd, frame_color=sa_chk_brd, frame_width=1)
            chk_sz = get_sz(chk_size_str)
            table.cell(chk_panel, 0, 0, "CHECKLIST", text_color=sa_chk_txt, text_size=chk_sz, text_halign=text.align_left, bgcolor=color.new(color.black, 50))
            for i = 0 to chk_count - 1
                table.cell(chk_panel, 0, i + 1, array.get(chk_labels, i), text_color=sa_chk_txt, text_size=chk_sz, text_halign=text.align_left)
