lvl_pdh.refresh_lvl(txt_pdh, ls_prev, ls_prev_test_str), lvl_pdl.refresh_lvl(txt_pdl, ls_prev, ls_prev_test_str), lvl_ath.refresh_lvl(txt_ath, ls_prev, ls_prev_test_str)
