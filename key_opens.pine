lvl_c1.refresh_lvl(txt_c1, ls_key, ls_key_test_str), lvl_c2.refresh_lvl(txt_c2, ls_key, ls_key_test_str), lvl_c3.refresh_lvl(txt_c3, ls_key, ls_key_test_str)
